<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/miraclo_qs_card_stock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/miraclo_studio_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp">

            <com.android.settings.miraclo.studio.MiraStudioArtView
                android:id="@+id/miraclo_qs_art_stock"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:importantForAccessibility="no" />

            <RadioButton
                android:id="@+id/miraclo_qs_radio_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:clickable="false"
                android:focusable="false"
                android:textColor="@color/miraclo_studio_title"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/miraclo_qs_card_coloros"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/miraclo_studio_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp">

            <com.android.settings.miraclo.studio.MiraStudioArtView
                android:id="@+id/miraclo_qs_art_coloros"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:importantForAccessibility="no" />

            <RadioButton
                android:id="@+id/miraclo_qs_radio_coloros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:clickable="false"
                android:focusable="false"
                android:textColor="@color/miraclo_studio_title"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/miraclo_qs_card_ios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/miraclo_studio_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp">

            <com.android.settings.miraclo.studio.MiraStudioArtView
                android:id="@+id/miraclo_qs_art_ios"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:importantForAccessibility="no" />

            <RadioButton
                android:id="@+id/miraclo_qs_radio_ios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:clickable="false"
                android:focusable="false"
                android:textColor="@color/miraclo_studio_title"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/miraclo_qs_card_oneui"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/miraclo_studio_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp">

            <com.android.settings.miraclo.studio.MiraStudioArtView
                android:id="@+id/miraclo_qs_art_oneui"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:importantForAccessibility="no" />

            <RadioButton
                android:id="@+id/miraclo_qs_radio_oneui"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:clickable="false"
                android:focusable="false"
                android:textColor="@color/miraclo_studio_title"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
