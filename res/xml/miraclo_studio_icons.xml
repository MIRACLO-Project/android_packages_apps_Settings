<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="miraclo_studio_icons"
    android:title="@string/miraclo_icons_title">

    <PreferenceCategory android:key="miraclo_icons_style_cat" android:title="@string/miraclo_icons_style_cat">
        <com.android.settings.miraclo.MiraIconStylePreference
            android:key="miraclo_icons_style"
            android:title="@string/miraclo_icons_style"
            android:entries="@array/miraclo_icons_style_e"
            android:entryValues="@array/miraclo_icons_style_v"
            android:summary="%s" />
    </PreferenceCategory>
    <PreferenceCategory android:key="miraclo_icons_network" android:title="@string/miraclo_icons_network">
        <com.android.settings.miraclo.SecureSettingSwitchPreference
            android:key="miraclo_sb_stack_sims"
            android:title="@string/miraclo_icons_stack"
            android:summary="@string/miraclo_icons_stack_sum"
            android:defaultValue="false" />
        <com.android.settings.miraclo.SecureSettingSwitchPreference
            android:key="miraclo_sb_nodata_mark"
            android:title="@string/miraclo_icons_nodata"
            android:summary="@string/miraclo_icons_nodata_sum"
            android:defaultValue="true" />
        <com.android.settings.miraclo.SecureSettingListPreference
            android:key="miraclo_sb_net_label"
            android:title="@string/miraclo_icons_netlabel"
            android:entries="@array/miraclo_icons_netlabel_e"
            android:entryValues="@array/miraclo_v2"
            android:defaultValue="0"
            android:summary="%s" />
        <com.android.settings.miraclo.SecureSettingSwitchPreference
            android:key="miraclo_sb_net_plus"
            android:title="@string/miraclo_icons_plus"
            android:summary="@string/miraclo_icons_plus_sum"
            android:defaultValue="true" />
        <com.android.settings.miraclo.SecureSettingListPreference
            android:key="miraclo_sb_volte"
            android:title="@string/miraclo_icons_volte"
            android:entries="@array/miraclo_icons_volte_e"
            android:entryValues="@array/miraclo_v3"
            android:defaultValue="0"
            android:summary="%s" />
        <com.android.settings.miraclo.SecureSettingSwitchPreference
            android:key="miraclo_sb_vowifi"
            android:title="@string/miraclo_icons_vowifi"
            android:summary="@string/miraclo_icons_vowifi_sum"
            android:defaultValue="false" />
        <Preference
            android:key="miraclo_icons_speed"
            android:title="@string/miraclo_speed_title"
            android:summary="@string/miraclo_speed_sum"
            android:fragment="com.android.settings.miraclo.studio.MiraStudioNetSpeedFragment" />
    </PreferenceCategory>

    <PreferenceCategory android:key="miraclo_icons_clock" android:title="@string/miraclo_icons_clock">
        <com.android.settings.miraclo.SecureSettingSwitchPreference
            android:key="clock_seconds"
            android:title="@string/miraclo_icons_seconds"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:key="miraclo_icons_show" android:title="@string/miraclo_icons_show">
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="wifi"
            android:title="Wi-Fi" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="bluetooth"
            android:title="Bluetooth" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="hotspot"
            android:title="Hotspot" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="vpn"
            android:title="VPN" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="airplane"
            android:title="Airplane" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="nfc"
            android:title="NFC" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="zen"
            android:title="Do not disturb" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="alarm_clock"
            android:title="Alarm" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="volume"
            android:title="Ringer" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="headset"
            android:title="Headphones" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="location"
            android:title="Location" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="rotate"
            android:title="Rotation lock" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="cast"
            android:title="Cast" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="screen_record"
            android:title="Recording" />
        <com.android.settings.miraclo.IconBlacklistSwitchPreference
            android:key="data_saver"
            android:title="Data saver" />
    </PreferenceCategory>

    <PreferenceCategory android:key="miraclo_icons_layout" android:title="@string/miraclo_icons_layout">
        <com.android.settings.miraclo.SecureSettingSliderPreference
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:key="miraclo_sb_pad_start"
            android:title="@string/miraclo_icons_pad_left"
            android:max="24"
            app:min="-12"
            app:showSeekBarValue="true"
            android:defaultValue="0" />
        <com.android.settings.miraclo.SecureSettingSliderPreference
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:key="miraclo_sb_pad_end"
            android:title="@string/miraclo_icons_pad_right"
            android:max="24"
            app:min="-12"
            app:showSeekBarValue="true"
            android:defaultValue="0" />
        <com.android.settings.miraclo.SecureSettingSliderPreference
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:key="miraclo_sb_height"
            android:title="@string/miraclo_icons_height"
            android:max="44"
            app:min="34"
            app:showSeekBarValue="true"
            android:defaultValue="34" />
    </PreferenceCategory>
</PreferenceScreen>
