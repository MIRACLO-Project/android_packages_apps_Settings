<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="miraclo_studio_volume"
    android:title="@string/miraclo_studio_volume_title">

    <com.android.settingslib.widget.TopIntroPreference
        android:key="miraclo_volume_intro"
        android:title="@string/miraclo_studio_volume_intro" />

    <com.android.settings.miraclo.SecureSettingSwitchPreference
        android:key="miraclo_volume_panel"
        android:title="@string/miraclo_volume_panel_title"
        android:summary="@string/miraclo_volume_panel_summary"
        android:defaultValue="false" />

    <com.android.settings.miraclo.SecureSettingListPreference
        android:key="miraclo_volume_side"
        android:dependency="miraclo_volume_panel"
        android:title="@string/miraclo_volume_side_title"
        android:entries="@array/miraclo_volume_side_e"
        android:entryValues="@array/miraclo_volume_side_v"
        android:defaultValue="0"
        android:summary="%s" />

    <!-- MIRACLO: everything on this page back to how it ships -->
    <com.android.settings.miraclo.MiraResetPreference
        android:key="miraclo_reset_page"
        android:order="10000" />
</PreferenceScreen>
